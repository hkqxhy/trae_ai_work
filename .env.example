# 租房雷达环境变量示例
# 复制为 .env 并填入真实值后使用

# 运行环境：production 表示生产模式（监听 0.0.0.0，托管前端静态产物）
APP_ENV=production

# AI 供应商：mock（无需密钥，使用演示数据）或 qwen（千问真实调用）
AI_PROVIDER=mock

# 千问 API Key（使用 qwen 时必填，二选一）
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# 千问模型与接口地址
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务监听配置
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8787
AI_TRUST_PROXY=false

# CORS 允许的来源（生产同源部署留空即可；前后端分离部署时填前端地址）
CORS_ORIGIN=

# AI 调用限制
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_TEXT_LENGTH=20000
AI_MAX_IMAGES=6
AI_MAX_IMAGE_SIZE_MB=8
AI_MAX_REQUEST_BODY_MB=64
AI_MAX_CANDIDATES=8
QWEN_VL_MODEL=qwen-vl-plus
